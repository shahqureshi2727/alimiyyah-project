# Firebase web client config. These are public client keys; security comes from
# Firestore rules and Firebase Auth domain restrictions, not from secrecy.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional. Leave unset to disable Sentry locally or in forks.
VITE_SENTRY_DSN=

# Optional Vercel-only source map upload settings for @sentry/vite-plugin.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
