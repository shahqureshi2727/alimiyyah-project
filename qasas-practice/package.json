{
  "name": "qasas-practice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE_BUNDLE=1 vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "lhci": "VITE_FIREBASE_API_KEY=lhci VITE_FIREBASE_AUTH_DOMAIN=lhci.firebaseapp.com VITE_FIREBASE_PROJECT_ID=lhci VITE_FIREBASE_STORAGE_BUCKET=lhci.appspot.com VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000 VITE_FIREBASE_APP_ID=1:000000000000:web:lhci vite build && lhci autorun",
    "lint": "eslint .",
    "format": "prettier \"src/**/*.{js,jsx,css}\" --write",
    "format:check": "prettier \"src/**/*.{js,jsx,css}\" --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "npx --yes firebase-tools@14.22.0 emulators:exec --only firestore \"vitest run --config vite.rules.config.js\"",
    "test:e2e": "npx --yes firebase-tools@14.22.0 --project demo-qasas-practice emulators:exec --only auth,firestore \"playwright test\"",
    "preview": "vite preview",
    "validate:fiqh": "node scripts/validate-fiqh-bank.mjs",
    "validate:morphology": "node scripts/validate-morphology-bank.mjs",
    "migrate:topic-stats": "node scripts/migrate-topic-stats.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.68.0",
    "firebase": "^12.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.2.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
