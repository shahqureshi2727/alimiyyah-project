rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function validUsername(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    function validQuizMode(value) {
      return value in [
        "irab",
        "nounFeatures",
        "roles",
        "vocab",
        "morphology",
        "fiqh",
        "hadith",
        "tafsir",
        "review"
      ];
    }

    function validBankSource(value) {
      return value in ["qasas", "quran", "fiqh", "hadith", "tafsir", "mixed"];
    }

    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.role == "student" &&
        request.resource.data.username is string &&
        request.resource.data.username.size() >= 3 &&
        request.resource.data.username.size() <= 20;

      allow update, delete: if false;

      match /topicStats/{statId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());

        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly([
            "userId",
            "category",
            "subtopic",
            "attempts",
            "correct",
            "lastAttempted",
            "ewmaScore",
            "reviewIntervalDays",
            "nextDueAt"
          ]) &&
          request.resource.data.keys().hasAll([
            "userId",
            "category",
            "subtopic",
            "attempts",
            "correct",
            "lastAttempted",
            "ewmaScore",
            "reviewIntervalDays",
            "nextDueAt"
          ]) &&
          request.resource.data.userId == userId &&
          request.resource.data.category in ["fiqh", "hadith", "arabic", "tafsir"] &&
          request.resource.data.subtopic is string &&
          request.resource.data.subtopic.size() >= 1 &&
          request.resource.data.subtopic.size() <= 80 &&
          statId == request.resource.data.category + "_" + request.resource.data.subtopic &&
          request.resource.data.attempts is int &&
          request.resource.data.attempts >= 1 &&
          request.resource.data.attempts <= 10000 &&
          request.resource.data.correct is int &&
          request.resource.data.correct >= 0 &&
          request.resource.data.correct <= request.resource.data.attempts &&
          request.resource.data.ewmaScore is number &&
          request.resource.data.ewmaScore >= 0 &&
          request.resource.data.ewmaScore <= 1 &&
          request.resource.data.reviewIntervalDays is int &&
          request.resource.data.reviewIntervalDays >= 1 &&
          request.resource.data.reviewIntervalDays <= 30 &&
          request.resource.data.nextDueAt is timestamp &&
          request.resource.data.nextDueAt > request.time &&
          request.resource.data.lastAttempted == request.time;

        allow delete: if false;
      }
    }

    match /quizResults/{resultId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          "userId",
          "username",
          "mode",
          "bankSource",
          "score",
          "total",
          "durationSeconds",
          "completedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "username",
          "mode",
          "bankSource",
          "score",
          "total",
          "durationSeconds",
          "completedAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        validUsername(request.resource.data.username) &&
        validQuizMode(request.resource.data.mode) &&
        validBankSource(request.resource.data.bankSource) &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.total is int &&
        request.resource.data.total >= 1 &&
        request.resource.data.total <= 15 &&
        request.resource.data.score <= request.resource.data.total &&
        (
          (request.resource.data.mode == "review" && request.resource.data.total <= 15) ||
          (request.resource.data.mode != "review" && request.resource.data.total == 10)
        ) &&
        request.resource.data.durationSeconds is number &&
        request.resource.data.durationSeconds > 0 &&
        request.resource.data.durationSeconds <= 3600 &&
        request.resource.data.completedAt == request.time;

      allow update, delete: if false;
    }

    match /answerEvents/{eventId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          "userId",
          "username",
          "mode",
          "bankSource",
          "topic",
          "group",
          "questionId",
          "correct",
          "answeredAt",
          "quizResultId"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "username",
          "mode",
          "bankSource",
          "topic",
          "group",
          "questionId",
          "correct",
          "answeredAt",
          "quizResultId"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        validUsername(request.resource.data.username) &&
        validQuizMode(request.resource.data.mode) &&
        validBankSource(request.resource.data.bankSource) &&
        request.resource.data.topic is string &&
        request.resource.data.topic.size() >= 1 &&
        request.resource.data.topic.size() <= 80 &&
        (
          request.resource.data.group == null ||
          (
            request.resource.data.group is string &&
            request.resource.data.group.size() >= 1 &&
            request.resource.data.group.size() <= 80
          )
        ) &&
        request.resource.data.questionId is string &&
        request.resource.data.questionId.size() >= 1 &&
        request.resource.data.questionId.size() <= 160 &&
        request.resource.data.correct is bool &&
        (
          request.resource.data.quizResultId == null ||
          (
            request.resource.data.quizResultId is string &&
            request.resource.data.quizResultId.size() >= 1 &&
            request.resource.data.quizResultId.size() <= 160
          )
        ) &&
        request.resource.data.answeredAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
